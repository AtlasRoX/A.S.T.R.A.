# Copy to engine/.env (git ignores it) and fill in. Read by app/assistant.py.
# NVIDIA NIM key from https://build.nvidia.com (used only by ASTRA Core, never sent to the browser).
NVIDIA_API_KEY=
# Optional: use another NIM model. Default: nvidia/nemotron-3.5-super-vl-120b-a12b, which is also used
# if this account cannot call the model set here.
NIM_MODEL=
